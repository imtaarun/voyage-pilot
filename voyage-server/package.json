{
  "name": "voyage-pilot-server",
  "version": "1.0.0",
  "description": "Typescript-NodeJs based server application for VoyagePilot app",
  "main": "dist/app.js",
  "scripts": {
    "start": "ts-node src/app.ts",
    "build": "tsc",
    "serve": "node dist/app.js",
    "migrate": "tsx ./node_modules/.bin/sequelize-cli db:migrate",
    "db-init": "tsx ./node_modules/.bin/sequelize-cli db:create"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@types/node": "^20.9.4",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "pg": "^8.16.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/pg": "^8.15.4",
    "@types/sequelize": "^4.28.20",
    "prisma": "^6.9.0",
    "sequelize-cli": "^6.6.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
